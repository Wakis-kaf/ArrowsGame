<Window x:Class="UFXlsx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UFXlsx"
        mc:Ignorable="d"
        Title="Excel配置表导出工具" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 颜色资源 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#BBDEFB"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F44336"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>

        <!-- 样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.1" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="DropAreaStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F8FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="30,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4-5h2v15h-2z" 
                      Fill="White" Width="28" Height="28" Margin="0,0,16,0"/>
                <TextBlock Text="Excel配置表导出工具" 
                         Foreground="White" 
                         FontSize="24" 
                         FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- 主要内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <!-- 配置文件卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeaderTextStyle}" 
                                   Text="配置文件"/>

                        <Label Style="{StaticResource LabelStyle}" 
                               Content="GlobalConfig.json 文件"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="globalConfigPath" 
                                     AllowDrop="true"
                                     Style="{StaticResource DropAreaStyle}"
                                     Text="拖拽 GlobalConfig.json 文件到此处 或 点击浏览按钮选择"
                                     DragEnter="GlobalConfig_DragEnter" 
                                     DragDrop.Drop="GlobalConfig_Drop"
                                     Cursor="Hand"
                                     MouseLeftButtonDown="GlobalConfigPath_MouseLeftButtonDown"/>

                            <Button x:Name="browse" 
                                    Content="浏览文件" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Padding="20,12"
                                    Click="BtnBrowseClick"/>
                        </Grid>

                        <TextBlock x:Name="configStatus" 
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- 配置表选择卡片 -->
                <Border x:Name="configTableCard" 
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource HeaderTextStyle}" 
                                       Text="选择导出配置表"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnSelectAll" 
                                        Content="全选" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnSelectAll_Click"/>
                                <Button x:Name="btnUnselectAll" 
                                        Content="取消全选" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnUnselectAll_Click"/>
                            </StackPanel>
                        </Grid>

                        <Label Style="{StaticResource LabelStyle}" 
                               Content="请勾选需要导出的配置表"/>

                        <Border BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1" 
                                Background="White"
                                MaxHeight="350"
                                CornerRadius="4"
                                Margin="0,0,0,20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="configTableList" 
                                              Margin="6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 修复：移除Style引用，直接设置属性 -->
                                            <CheckBox Content="{Binding Name}" 
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="6,8"
                                                      FontSize="15"
                                                      Cursor="Hand"
                                                      VerticalContentAlignment="Center"
                                                      Padding="4,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="selectedCountText" 
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- 日志输出卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource HeaderTextStyle}" 
                                       Text="日志输出"/>

                            <Button x:Name="BtnClearLog" 
                                    Content="清除日志" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Grid.Column="1"
                                    Click="BtnClearLogClick"/>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1" 
                                Background="White"
                                CornerRadius="4"
                                Margin="0,12,0,0">
                            <TextBox x:Name="TxtLogOutput" 
                                     IsReadOnly="true"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="White"
                                     Foreground="#333333"
                                     BorderThickness="0"
                                     FontFamily="Consolas, 'Courier New', monospace"
                                     FontSize="14"
                                     MinHeight="250"
                                     TextChanged="TextBox_TextChanged"
                                     VerticalContentAlignment="Top"/>
                        </Border>

                        <TextBlock Margin="0,12,0,0" 
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13">
                            <Run Text="提示："/>
                            <Run Text="日志区域支持文本选择，可按 Ctrl+C 复制"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" 
                Background="{StaticResource CardBackground}" 
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1,0,0,0"
                Padding="30,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" 
                        Content="取消" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="btnOutputSelected" 
                        Content="导出选中配置表" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="16,0,0,0"
                        Padding="28,14"
                        FontSize="16"
                        Click="BtnOutputSelected_Click"/>

                <Button x:Name="btnOutputAllSingle" 
                        Content="导出全部配置表" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="16,0,0,0"
                        Padding="28,14"
                        FontSize="16"
                        Click="BtnOutputAllSingleClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>